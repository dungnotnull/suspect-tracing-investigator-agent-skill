                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/link_analysis_output"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "executionTimeMs": {
                          "type": "number"
                        },
