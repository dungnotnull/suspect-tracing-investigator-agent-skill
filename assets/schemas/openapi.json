                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/tools/generate_interview_questions": {
      "post": {
        "operationId": "generate_interview_questions",
        "summary": "Generate a structured cognitive-interview question set (Fisher & Geiselman, 1992) covering rapport, open narrative, context reinstatement, varied recall, changed perspective, focused follow-up, and closing.",
        "tags": [
          "output"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
